{
  "name": "reposcope-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode live",
    "preview": "vite preview",
    "build": "npm run typecheck && vite build",
    "build:live": "npm run typecheck && vite build --mode live",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:build-config": "node scripts/verify-build-config.mjs",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e:live && npm run test:e2e:static",
    "test:e2e:live": "npm run build:live && node scripts/run-e2e.mjs --grep @live",
    "test:e2e:static": "npm run build && node scripts/run-e2e.mjs --grep @static"
  },
  "dependencies": {
    "@tanstack/react-query": "latest",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^26.4.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "29.0.0",
    "typescript": "latest",
    "vitest": "latest"
  }
}
