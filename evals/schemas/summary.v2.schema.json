{
  "$defs": {
    "EvaluationUsage": {
      "additionalProperties": false,
      "properties": {
        "estimated_cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Usd"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "model_attempts": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Attempts"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "rate_card_version": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Card Version"
        },
        "tool_calls": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        }
      },
      "title": "EvaluationUsage",
      "type": "object"
    },
    "SystemMetrics": {
      "additionalProperties": false,
      "properties": {
        "case_count": {
          "minimum": 1,
          "title": "Case Count",
          "type": "integer"
        },
        "citation_hallucination_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation Hallucination Rate"
        },
        "citation_validity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation Validity"
        },
        "citations_emitted": {
          "minimum": 0,
          "title": "Citations Emitted",
          "type": "integer"
        },
        "citations_valid": {
          "minimum": 0,
          "title": "Citations Valid",
          "type": "integer"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Usd"
        },
        "file_recall_at_5": {
          "maximum": 1,
          "minimum": 0,
          "title": "File Recall At 5",
          "type": "number"
        },
        "hallucinated_citations": {
          "minimum": 0,
          "title": "Hallucinated Citations",
          "type": "integer"
        },
        "median_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median Latency Ms"
        },
        "mrr": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mrr",
          "type": "number"
        },
        "successful_cases": {
          "minimum": 0,
          "title": "Successful Cases",
          "type": "integer"
        },
        "system": {
          "enum": [
            "issue_only",
            "reposcope"
          ],
          "title": "System",
          "type": "string"
        },
        "total_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Input Tokens"
        },
        "total_output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Output Tokens"
        }
      },
      "required": [
        "system",
        "case_count",
        "successful_cases",
        "file_recall_at_5",
        "mrr",
        "citations_emitted",
        "citations_valid",
        "hallucinated_citations"
      ],
      "title": "SystemMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_count": {
      "minimum": 1,
      "title": "Case Count",
      "type": "integer"
    },
    "configuration_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Configuration Digest"
    },
    "dataset_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Digest",
      "type": "string"
    },
    "documented_model_version": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Documented Model Version"
    },
    "file_recall_at_5_delta": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "File Recall At 5 Delta"
    },
    "mrr_delta": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mrr Delta"
    },
    "prediction_manifest_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prediction Manifest Digest"
    },
    "preflight_usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvaluationUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provider": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "provider_backend_drift": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Backend Drift"
    },
    "requested_model": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Model"
    },
    "run_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "const": "reposcope.eval.summary.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "enum": [
        "development",
        "hidden",
        "all"
      ],
      "title": "Split",
      "type": "string"
    },
    "systems": {
      "items": {
        "$ref": "#/$defs/SystemMetrics"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Systems",
      "type": "array"
    },
    "total_provider_usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvaluationUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "split",
    "dataset_digest",
    "case_count",
    "systems"
  ],
  "title": "EvaluationSummaryV2",
  "type": "object"
}
